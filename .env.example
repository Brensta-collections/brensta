# ============================================================
# BRENSTA — environment variables (EXAMPLE)
# Copy to .env.local for local dev. NEVER commit real secrets.
# ============================================================

# ── Database ───────────────────────────────────────────────
#
# Local dev: a single Postgres instance is fine — use the same URL in both
# DATABASE_URL and DIRECT_URL (just paste it twice).
#
# Production on Neon: Neon exposes the SAME database at two endpoints and
# BOTH are needed by Prisma.
#   - DATABASE_URL -> the POOLED endpoint (hostname contains "-pooler").
#     Used by the running app for short-lived queries via PgBouncer in
#     transaction mode. Must include `?pgbouncer=true` so Prisma skips
#     prepared statements, plus `sslmode=require`.
#   - DIRECT_URL -> the DIRECT endpoint (same hostname WITHOUT "-pooler").
#     Used by `prisma migrate deploy`, `prisma db pull`, and the shadow
#     database. Session mode; no pgbouncer flag.
# Neon placeholders shown here for the ap-southeast-1 (Singapore) region.
DATABASE_URL="postgresql://brensta:REPLACE_WITH_PASSWORD@127.0.0.1:5432/brensta_dev?schema=public"
DIRECT_URL="postgresql://brensta:REPLACE_WITH_PASSWORD@127.0.0.1:5432/brensta_dev?schema=public"

# Neon production shape (uncomment on the VM and paste the real strings):
# DATABASE_URL="postgresql://<USER>:<PW>@ep-<id>-pooler.ap-southeast-1.aws.neon.tech/<DB>?sslmode=require&pgbouncer=true&connect_timeout=10"
# DIRECT_URL="postgresql://<USER>:<PW>@ep-<id>.ap-southeast-1.aws.neon.tech/<DB>?sslmode=require&connect_timeout=10"

# ── Auth (NextAuth v5) ─────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_32B_RANDOM"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional Google OAuth (leave empty to disable Google sign-in)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="BRENSTA"
NEXT_PUBLIC_BRAND_TAGLINE="Fashion & Lifestyle for Every You"

# ── Email (Resend) ─────────────────────────────────────────
# Get key at https://resend.com (3k/mo free). Leave empty to log emails to console in dev.
RESEND_API_KEY=""
EMAIL_FROM="BRENSTA <no-reply@brensta.com>"

# ── Payments — Razorpay (SANDBOX ONLY until explicit live approval) ──
# Dashboard → Settings → API Keys → Generate Test Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Uploads ────────────────────────────────────────────────
# "local" writes to ./public/uploads; "s3" uses S3-compatible storage (future)
UPLOAD_DRIVER="local"
UPLOAD_MAX_MB="8"

# ── Shipping (interface stub for now; wire real provider later) ──
SHIPPING_PROVIDER="stub"              # stub | delhivery | shiprocket
SHIPPING_FREE_THRESHOLD_INR="999"
SHIPPING_FLAT_RATE_INR="50"
SHIPPING_COD_FEE_INR="40"
COD_ENABLED="true"

# ── Business ───────────────────────────────────────────────
DEFAULT_CURRENCY="INR"
DEFAULT_COUNTRY="IN"
TAX_INCLUSIVE="true"                  # prices shown include GST (set per spec: "Inclusive of all taxes")

# ── Admin bootstrap (used by: pnpm create:admin) ──
# This creates the first admin only if no admin exists.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

# ── Rate limiting / observability (optional) ──
LOG_LEVEL="info"
